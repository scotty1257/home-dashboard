{
  "name": "@home-dashboard/voice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": ".venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8788 --reload",
    "start": ".venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8788",
    "setup": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "test": ".venv/bin/python -m pytest -q",
    "typecheck": ".venv/bin/python -m compileall -q app",
    "clean": "rm -rf .venv __pycache__"
  }
}
