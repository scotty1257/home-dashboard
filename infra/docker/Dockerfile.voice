# Home Dashboard voice assistant — Python FastAPI
FROM python:3.11-slim

WORKDIR /app
COPY services/voice/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY services/voice/app ./app
COPY .env* ./

ENV API_URL=http://api:8787
EXPOSE 8788

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8788"]
