[Unit]
Description=Home Dashboard API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dashboard
Group=dashboard
WorkingDirectory=/opt/home-dashboard/services/api
Environment=NODE_ENV=production
# Run via tsx (handles the workspace TypeScript source directly).
ExecStart=/opt/home-dashboard/node_modules/.bin/tsx /opt/home-dashboard/services/api/src/index.ts
Restart=always
RestartSec=3
# Hardening. VOICE_NOTE_DIR defaults to /opt/home-dashboard/var/voice-notes
# (still covered by the var path below, listed explicitly for clarity). If you
# point VOICE_NOTE_DIR elsewhere in .env, add that path here too.
ReadWritePaths=/opt/home-dashboard/var /opt/home-dashboard/var/voice-notes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
