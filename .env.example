# ---- Core ----
# Host/port the dashboard API binds to (localhost for kiosk deployments)
API_HOST=127.0.0.1
API_PORT=8787
# URL the web app uses to reach the API (empty = same origin through the dev proxy)
VITE_API_URL=

# ---- Database ----
DATABASE_PATH=./var/dashboard.sqlite

# ---- Weather (Open-Meteo, no key required) ----
WEATHER_LATITUDE=40.7128
WEATHER_LONGITUDE=-74.0060
WEATHER_UNITS=imperial
WEATHER_REFRESH_MINUTES=15

# ---- Home Assistant ----
# Leave HA_URL empty to use the built-in demo (fake) device provider.
HA_URL=
HA_TOKEN=
# Comma-separated list of entity domains to hide, e.g. automation,person
HA_HIDDEN_DOMAINS=automation,person,zone,update

# ---- Spotify ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/api/spotify/callback

# ---- Voice ----
VOICE_PORT=8788
# Providers: local (stubs), openai, anthropic, custom
STT_PROVIDER=local
LLM_PROVIDER=local
TTS_PROVIDER=local
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
